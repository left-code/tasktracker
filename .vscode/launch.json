{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TaskTracker",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/TaskTracker/bin/Debug/net10.0/TaskTracker.dll",
            "cwd": "${workspaceFolder}",
            // The app reads single key presses, which the Debug Console cannot deliver.
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ]
}
